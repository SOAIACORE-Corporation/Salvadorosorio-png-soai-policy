{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.soaiacore.com/analysis/analysis-profile-v0.3.schema.json",
  "title": "SOAIACORE AnalysisProfile v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_profile_id",
    "version",
    "method_families",
    "human_review_mode",
    "restricted_workflow",
    "evidence_requirements",
    "output_semantics"
  ],
  "properties": {
    "analysis_profile_id": {
      "type": "string",
      "pattern": "^AP-[0-9]{3}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "method_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "INTERPRETIVE",
          "RELATIONAL",
          "LONGITUDINAL",
          "NARRATIVE",
          "TEMPORAL_MICROSEQUENCE",
          "MULTIMODAL",
          "STATISTICAL_FORECASTING",
          "CAUSAL_INFERENCE",
          "PROBABILISTIC_INFERENCE",
          "EXTRACTION",
          "CLASSIFICATION",
          "SCENARIO_GENERATION"
        ]
      }
    },
    "human_review_mode": {
      "enum": [
        "NONE",
        "OPTIONAL",
        "REQUIRED"
      ]
    },
    "restricted_workflow": {
      "type": "boolean"
    },
    "inference_regime": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CONTROLLED"
      ]
    },
    "evidence_requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_state": {
          "enum": [
            "REFERENCED",
            "INVENTORIED",
            "ACQUIRED",
            "FIXITY_VERIFIED",
            "PROCESSED",
            "VERIFIED",
            "ADMISSIBLE"
          ]
        },
        "counterevidence_required": {
          "type": "boolean"
        },
        "negative_audit_sample": {
          "enum": [
            "NOT_REQUIRED",
            "OPTIONAL",
            "REQUIRED"
          ]
        },
        "provenance_required": {
          "const": true
        }
      },
      "required": [
        "minimum_state",
        "provenance_required"
      ]
    },
    "output_semantics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "OBSERVATION",
          "SIGNAL",
          "PATTERN",
          "RELATION",
          "EVENT",
          "ESTIMATE",
          "FORECAST",
          "SCENARIO"
        ]
      }
    },
    "authorization_tier": {
      "enum": [
        "T0_STANDARD",
        "T1_CONTROLLED",
        "T2_RESTRICTED",
        "T3_SPECIALIZED_RESEARCH"
      ]
    },
    "metadata": {
      "type": "object"
    }
  }
}